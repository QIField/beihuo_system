# =============================================================================
# 备货系统环境配置文件示例
# =============================================================================
# 使用说明：
# 1. 复制此文件并命名为 .env
# 2. 根据实际环境修改配置项
# 3. 敏感信息（密码、密钥等）请勿提交到版本控制
# 4. 修改配置后需要重启应用才能生效
# =============================================================================


# =============================================================================
# ORM 数据库配置（SQLAlchemy 使用）
# =============================================================================
# 用途：使用 SQLAlchemy ORM 进行数据库操作时的配置
# 使用模块：config/orm_config.py, app/utils/orm/

# ORM 数据库主机地址
# 示例：127.0.0.1（本地）、192.168.1.100（内网）、xxx.xxx.xxx.xxx（公网）
ORM_MYSQL_HOST=127.0.0.1

# ORM 数据库端口
# MySQL 默认端口：3306
ORM_MYSQL_PORT=3306

# ORM 数据库用户名
ORM_MYSQL_USER=root

# ORM 数据库密码
ORM_MYSQL_PASSWORD=123456

# ORM 数据库名称
ORM_MYSQL_DATABASE=test

# ORM 数据库字符集
# 推荐使用 utf8mb4，支持完整的 Unicode（包括 emoji）
ORM_MYSQL_CHARSET=utf8mb4


# =============================================================================
# 原生 SQL 数据库配置（本地开发环境）
# =============================================================================
# 用途：使用原生 SQL（pymysql）进行数据库操作时的本地配置
# 使用场景：本地开发、快速测试、无网络延迟
# 使用模块：config/db_config.py, app/utils/database_connection.py

# 本地数据库主机地址
MYSQL_LOCAL_HOST=localhost

# 本地数据库端口
MYSQL_LOCAL_PORT=3306

# 本地数据库用户名
MYSQL_LOCAL_USER=root

# 本地数据库密码
MYSQL_LOCAL_PASSWORD=123456

# 本地数据库名称
MYSQL_LOCAL_DATABASE=test


# =============================================================================
# 原生 SQL 数据库配置（线上生产环境）
# =============================================================================
# 用途：使用原生 SQL（pymysql）进行数据库操作时的线上配置
# 使用场景：生产环境、真实网络延迟测试
# 注意事项：
#   - 线上数据库操作请谨慎，避免误修改数据
#   - 建议在本地测试充分后再使用线上数据库
#   - 此配置包含真实密码，请勿分享或提交到公开仓库

# 线上数据库主机地址
MYSQL_ONLINE_HOST=113.45.176.129

# 线上数据库端口
MYSQL_ONLINE_PORT=3306

# 线上数据库用户名
MYSQL_ONLINE_USER=fsbbr_data

# 线上数据库密码
MYSQL_ONLINE_PASSWORD=wRCA8AGn3a568f4X

# 线上数据库名称
MYSQL_ONLINE_DATABASE=fsbbr_data


# =============================================================================
# ORM 连接池配置
# =============================================================================
# 说明：SQLAlchemy 连接池配置，优化数据库连接性能
# 参考文档：https://docs.sqlalchemy.org/en/14/core/pooling.html

# 连接池大小：池中保持的空闲连接数
# 建议值：5-20，根据并发量调整
ORM_POOL_SIZE=5

# 最大溢出连接数：超过 pool_size 后可以额外创建的连接数
# 总最大连接数 = POOL_SIZE + MAX_OVERFLOW
ORM_MAX_OVERFLOW=20

# 连接池超时时间（秒）：获取连接时的最大等待时间
# 超过此时间仍未获取到连接将抛出异常
ORM_POOL_TIMEOUT=30

# 连接回收时间（秒）：连接超过这个时间会被回收
# 作用：避免 MySQL 服务器断开连接（MySQL 默认 8 小时断开空闲连接）
# 建议值：小于 MySQL 的 wait_timeout（默认 28800 秒）
ORM_POOL_RECYCLE=3600

# 是否打印 SQL 语句
# 开发时设为 true 方便调试 SQL，生产环境必须设为 false
# 注意：开启后会在控制台输出所有执行的 SQL 语句
ORM_ECHO=false


# =============================================================================
# Flask 应用配置（可选）
# =============================================================================
# 说明：Flask Web 框架相关配置
# 如不使用 Flask 可忽略此部分

# Flask 应用入口文件
#FLASK_APP=beihuo_system.py

# Flask 运行环境
# 开发环境：development（开启调试模式）
# 生产环境：production（关闭调试模式）
#FLASK_ENV=development

# Flask 密钥（用于会话加密、CSRF 保护等）
# 生产环境请设置为复杂的随机字符串
#SECRET_KEY=your-secret-key-here-change-this-in-production

